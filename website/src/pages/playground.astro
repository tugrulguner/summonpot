---
import { readFile } from 'node:fs/promises';
import { Code } from 'astro:components';
import { resolve } from 'node:path';
import { posthogInitialization } from '../analytics/posthog.js';
const example = await readFile(resolve(process.cwd(), '../examples/07_bound_operation.py'), 'utf8');
const signature = example.slice(example.indexOf('def load_customer('), example.indexOf('    """Load one approved')).trimEnd();
const binding = example.slice(example.indexOf('customer_lookup = Operation('), example.indexOf('summon = Summon(')).trimEnd();
const endpoint = example.slice(example.indexOf('@summon('), example.indexOf('if __name__')).trimEnd();
const contract = `${signature}
    ...

${binding}

${endpoint}`;
---

<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content="Explore Summonpot's shipped bounded-operation contract in a browser-local preview." /><title>Summonpot playground</title><script is:inline set:html={posthogInitialization}></script></head>
<body>
  <div class="family-header">
    <a class="product-home" href="/" aria-label="Summonpot homepage"><img src="/favicon.svg" width="28" height="28" alt="" /> <span>Summonpot</span></a>
    <a class="family-home-mobile" href="https://modepot.io/">ModePot</a>
    <button class="family-menu-button" type="button" aria-expanded="false" aria-controls="family-mobile-menu">Menu</button>
    <nav class="family-links" aria-label="ModePot family">
      <a href="https://modepot.io/">ModePot</a>
      <a href="https://github.com/tugrulguner/summonpot">GitHub</a>
      <a href="https://discord.gg/u3AANZr6RG">Community</a>
      <a href="https://tugrul.modepot.io/">About Tugrul</a>
    </nav>
  </div>
  <div id="family-mobile-menu" class="family-mobile-menu" role="region" aria-label="Menu" hidden>
    <nav class="family-mobile-resources" aria-label="ModePot family">
      <a href="https://github.com/tugrulguner/summonpot">GitHub</a>
      <a href="https://discord.gg/u3AANZr6RG">Community</a>
      <a href="https://tugrul.modepot.io/">About Tugrul</a>
    </nav>
    <nav class="family-mobile-docs" aria-label="Summonpot navigation">
      <a href="/">Overview</a><a href="/quick-start/">Quick start</a><a href="/architecture/">Architecture &amp; safety</a>
      <a href="/capabilities/">Capabilities</a><a href="/guides/operations/">Operations &amp; troubleshooting</a>
      <a href="/build/direct-execution/">Model-free endpoint</a><a href="/build/agent-choice/">Agent-backed choice</a>
      <a href="/reference/operations/">Operations &amp; bindings</a><a href="/internals/execution/">Execution flow</a><a href="/playground/">Contract playground</a>
    </nav>
  </div>
  <main>
    <nav><a href="/architecture/">Read the architecture ↗</a></nav>
    <header>
      <p class="eyebrow">Contract playground</p>
      <h1>A fixed request. A bounded choice.</h1>
      <p class="intro">The request owns the customer ID. Only the display format is available for an agent to choose.</p>
      <p class="preview-note">Here, you select that allowed choice yourself. No agent or Python server runs.</p>
    </header>
    <ol class="contract-flow" aria-label="Declared authority flow">
      <li><span>01</span><div><strong>Request fixes the ID</strong><code>FromRequest</code></div></li>
      <li><span>02</span><div><strong>Choice stays within two formats</strong><code>AgentChoice</code></div></li>
      <li><span>03</span><div><strong>Application runs one lookup</strong><code>Exactly(1)</code></div></li>
    </ol>
    <section class="workbench" aria-label="Bounded customer operation workbench">
      <div class="code-panel">
        <div class="panel-heading"><span>examples/07_bound_operation.py</span><a href="https://github.com/tugrulguner/summonpot/blob/main/examples/07_bound_operation.py">View source ↗</a></div>
        <div class="primary-code"><Code code={contract} lang="python" /></div>
        <p class="source-note">Shipped signature and declaration · lookup body omitted.</p>
        <details class="full-source"><summary>Complete shipped example</summary><Code code={example} lang="python" /></details>
      </div>
      <div class="controls-panel">
        <div class="panel-heading"><span>Try the declared boundary</span></div>
        <form id="customer-form" novalidate>
          <label>Customer ID <span>Request-owned · FromRequest</span><input name="customer_id" type="text" value="customer-7" required /><small>Approved IDs: customer-7 and customer-9</small></label>
          <label>Display format <span>Agent-owned · bounded choice</span><select name="format"><option value="summary">Summary</option><option value="detailed">Detailed</option></select><small>You select the permitted value in this preview.</small></label>
          <div class="actions"><button type="submit">Run contract</button><button class="secondary" type="button" id="reset">Reset</button></div>
          <button class="boundary-test" type="button" id="try-override">Try overriding the request-owned ID ↗</button>
          <p id="rejection" role="alert" aria-live="assertive"></p>
        </form>
        <section class="result" aria-live="polite" aria-atomic="true">
          <p class="result-label">Application-owned operation result</p>
          <div class="result-top"><h2 id="result-title">Ready to run</h2><span id="status">BROWSER PREVIEW</span></div>
          <p id="result-copy">The operation result will appear here.</p>
          <dl><div><dt>Customer ID</dt><dd id="bound-customer-id">—</dd></div><div><dt>Customer</dt><dd id="customer-name">—</dd></div><div><dt>Status</dt><dd id="customer-status">—</dd></div><div><dt>Chosen format</dt><dd id="customer-format">—</dd></div></dl>
          <details class="execution-detail"><summary>Inspect the bound arguments</summary>
            <ol class="steps"><li data-step="request">Validate request</li><li data-step="choice">Bound format choice</li><li data-step="operation">Required lookup × 1</li><li data-step="response">Typed operation result</li></ol>
            <p id="trace-input">Request · —</p><p id="trace-choice">AgentChoice · —</p><p id="trace-result">Operation result · —</p>
          </details>
        </section>
      </div>
    </section>
    <p class="boundary">No model, server, network call, arbitrary code, or extra capability runs in this browser preview. This shows the operation result, not an agent-authored final response. <a href="https://github.com/tugrulguner/summonpot/blob/main/examples/07_bound_operation.py">Run the real example</a> · <a href="https://modepot.io/">ModePot ↗</a></p>
  </main>
  <script>
    const familyMenuButton = document.querySelector<HTMLButtonElement>('.family-menu-button');
    const familyMenu = document.querySelector<HTMLElement>('#family-mobile-menu');
    if (familyMenuButton && familyMenu) {
      const closeMenu = (restoreFocus = false) => {
        familyMenu.hidden = true;
        familyMenuButton.setAttribute('aria-expanded', 'false');
        if (restoreFocus) familyMenuButton.focus();
      };
      familyMenuButton.addEventListener('click', () => {
        const opening = familyMenu.hidden;
        familyMenu.hidden = !opening;
        familyMenuButton.setAttribute('aria-expanded', String(opening));
      });
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && !familyMenu.hidden) closeMenu(true); });
      document.addEventListener('click', event => {
        if (event.target instanceof Node && !familyMenu.contains(event.target) && !familyMenuButton.contains(event.target)) closeMenu();
      });
    }
    // Same-origin embeds follow the site's explicit theme, not just system media.
    if (window.parent !== window) {
      try {
        const parentRoot = window.parent.document.documentElement;
        const parentThemeSelect = window.parent.document.querySelector<HTMLSelectElement>('starlight-theme-select select');
        const syncTheme = () => {
          const theme = parentThemeSelect?.value === 'light' || parentThemeSelect?.value === 'dark'
            ? parentThemeSelect.value
            : parentRoot.dataset.theme;
          if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
          else delete document.documentElement.dataset.theme;
        };
        syncTheme();
        const themeObserver = new MutationObserver(syncTheme);
        themeObserver.observe(parentRoot, { attributes: true, attributeFilter: ['data-theme'] });
        parentThemeSelect?.addEventListener('change', syncTheme);
        window.addEventListener('pagehide', () => parentThemeSelect?.removeEventListener('change', syncTheme), { once: true });
        window.addEventListener('pagehide', () => themeObserver.disconnect(), { once: true });
      } catch { /* Cross-origin embeds retain their system theme. */ }
    }
    const form = document.querySelector<HTMLFormElement>('#customer-form')!;
    const output = (id: string) => document.getElementById(id)!;
    function resetSteps() { document.querySelectorAll('[data-step]').forEach((el) => el.classList.remove('active')); }
    let runVersion = 0;
    let pendingTimers: Array<{ timer: number; cancel: () => void }> = [];
    function cancelRun() { runVersion++; pendingTimers.forEach(({ timer, cancel }) => { clearTimeout(timer); cancel(); }); pendingTimers = []; }
    function clearPresentation() {
      resetSteps(); output('result-title').textContent = 'Ready to run'; output('status').textContent = 'BROWSER PREVIEW'; output('result-copy').textContent = 'The operation result will appear here.';
      for (const id of ['bound-customer-id','customer-name','customer-status','customer-format']) output(id).textContent = '—';
      output('trace-input').textContent = 'Request · —'; output('trace-choice').textContent = 'AgentChoice · —'; output('trace-result').textContent = 'Operation result · —';
      output('rejection').textContent = ''; output('rejection').classList.remove('reject');
    }
    const reject = (message: string) => { output('rejection').textContent = message; output('rejection').classList.remove('reject'); void output('rejection').offsetWidth; output('rejection').classList.add('reject'); };
    form.addEventListener('submit', async (event) => {
      event.preventDefault(); cancelRun(); clearPresentation(); const version = runVersion;
      const data = new FormData(form); const customerId = String(data.get('customer_id')); const format = data.get('format');
      if (!/^customer-(7|9)$/.test(customerId)) { reject('Rejected: choose an approved customer ID (customer-7 or customer-9). The request owns this ID.'); return; }
      if (format !== 'summary' && format !== 'detailed') { reject('Rejected: format is outside the declared AgentChoice values.'); return; }
      output('trace-input').textContent = `FromRequest · customer_id=${customerId}`;
      output('trace-choice').textContent = `AgentChoice · ${format} (visitor-selected preview)`; output('trace-result').textContent = 'Operation result · running';
      const labels = ['request','choice','operation','response'];
      for (let i = 0; i < labels.length; i++) { document.querySelector(`[data-step="${labels[i]}"]`)?.classList.add('active'); await new Promise<void>((resolve) => { const timer = window.setTimeout(resolve, 240); pendingTimers.push({ timer, cancel: resolve }); }); if (version !== runVersion) return; }
      const record = customerId === 'customer-7' ? { name: 'Ada', status: 'active' } : { name: 'Grace', status: 'paused' };
      output('bound-customer-id').textContent = customerId;
      output('customer-name').textContent = record.name; output('customer-status').textContent = record.status; output('customer-format').textContent = String(format);
      output('trace-result').textContent = `Operation result · ${customerId} / ${record.name} / ${record.status} / ${format}`;
      output('result-title').textContent = `${record.name} · ${record.status}`; output('status').textContent = 'LOCAL CONTRACT PREVIEW';
      output('result-copy').textContent = format === 'summary' ? `${record.name} is ${record.status}.` : `${record.name} (${customerId}) — status: ${record.status}; format: detailed.`;
    });
    form.addEventListener('input', () => { cancelRun(); clearPresentation(); });
    document.querySelector<HTMLButtonElement>('#reset')!.addEventListener('click', () => { cancelRun(); HTMLFormElement.prototype.reset.call(form); clearPresentation(); });
    document.querySelector<HTMLButtonElement>('#try-override')!.addEventListener('click', () => reject('Rejected: customer_id is bound to FromRequest; an operation override cannot replace request-owned data.'));
  </script>
  <style>
    :global(*) { box-sizing:border-box; }
    :global(:root) { color-scheme:light dark; --mp-font-sans:'Avenir Next',Avenir,'Segoe UI',sans-serif; --mp-font-mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; --mp-canvas-light:#f8f7f4; --mp-surface-light:#fff; --mp-raised-light:#eceef1; --mp-ink-light:#181a1d; --mp-muted-light:#616b78; --mp-border-light:#c6cbd2; --mp-control-border-light:#616b78; --mp-error-light:#a4262b; --mp-canvas-dark:#16181b; --mp-surface-dark:#202226; --mp-raised-dark:#292d33; --mp-ink-dark:#edeff2; --mp-muted-dark:#aeb4bc; --mp-border-dark:#555d68; --mp-control-border-dark:#aeb4bc; --mp-error-dark:#ff9b9b; --mp-accent-light:#6542a6; --mp-accent-dark:#bba5f3; --bg:var(--mp-canvas-light); --surface:var(--mp-surface-light); --raised:var(--mp-raised-light); --ink:var(--mp-ink-light); --muted:var(--mp-muted-light); --border:var(--mp-border-light); --control-border:var(--mp-control-border-light); --error:var(--mp-error-light); --accent:var(--mp-accent-light); --code:#202226; --comment:#aeb4bc; --token:#edeff2; --green:#9b83ce; --button:#6542a6; --button-text:#fff; --focus:#6542a6; font-family:var(--mp-font-sans); }
    @media(prefers-color-scheme:dark) { :global(:root:not([data-theme='light']):not([data-theme='dark'])) { --bg:var(--mp-canvas-dark); --surface:var(--mp-surface-dark); --raised:var(--mp-raised-dark); --ink:var(--mp-ink-dark); --muted:var(--mp-muted-dark); --border:var(--mp-border-dark); --control-border:var(--mp-control-border-dark); --error:var(--mp-error-dark); --accent:var(--mp-accent-dark); --code:#202226; --comment:#c8cbd1; --token:#edeff2; --green:#bba5f3; --button:#bba5f3; --button-text:#181a1d; --focus:#bba5f3; } }
    :global(:root[data-theme='light']) { color-scheme:light; }
    :global(:root[data-theme='dark']), :global(:root[data-theme='dark']:not([data-theme='light'])) { color-scheme:dark; --bg:var(--mp-canvas-dark); --surface:var(--mp-surface-dark); --raised:var(--mp-raised-dark); --ink:var(--mp-ink-dark); --muted:var(--mp-muted-dark); --border:var(--mp-border-dark); --control-border:var(--mp-control-border-dark); --error:var(--mp-error-dark); --accent:var(--mp-accent-dark); --code:#202226; --comment:#c8cbd1; --token:#edeff2; --green:#bba5f3; --button:#bba5f3; --button-text:#181a1d; --focus:#bba5f3; }
    :global(body) { margin:0; background:var(--bg); color:var(--ink); font:16px/1.6 var(--mp-font-sans); }
    .family-header { height:64px; display:flex; align-items:center; gap:12px; padding-inline:24px; background:var(--raised); border-bottom:1px solid var(--border); font-size:14px; }
    .family-header>a { min-height:44px; display:inline-flex; align-items:center; gap:8px; color:var(--ink); text-decoration:none; }
    .family-header .product-home { font-size:16px; font-weight:650; margin-right:auto; }
    .family-header .family-home-mobile,.family-header .family-menu-button { display:none; }
    .family-links { display:flex; align-items:center; gap:2px; }
    .family-links a { min-width:44px; min-height:44px; display:inline-flex; align-items:center; justify-content:center; padding-inline:8px; border-radius:6px; color:var(--ink); font-weight:600; text-decoration:none; white-space:nowrap; }
    .family-links a:focus-visible,.family-menu-button:focus-visible,.family-mobile-menu a:focus-visible { outline:2px solid var(--focus); outline-offset:2px; }
    .family-mobile-menu,.family-mobile-menu[hidden] { display:none; }
    .family-mobile-resources,.family-mobile-docs { display:grid; gap:4px; }
    .family-mobile-resources { padding-bottom:12px; border-bottom:1px solid var(--border); }
    .family-mobile-docs { padding-top:12px; }
    .family-mobile-menu a { display:flex; align-items:center; min-height:44px; padding:8px 12px; border-radius:6px; color:var(--ink); font-weight:600; text-decoration:none; }
    .family-mobile-menu a:hover { background:var(--surface); }
    .family-header img { object-fit:contain; }
    main { max-width:1248px; padding:24px 24px 32px; margin:auto; }
    nav { display:flex; justify-content:flex-end; gap:16px; font-size:14px; }
    a { color:var(--accent); text-underline-offset:3px; } nav a { text-decoration:none; }
    header { margin:28px 0 20px; }
    .eyebrow { margin:0 0 7px; color:var(--muted); font-size:14px; }
    h1 { font-size:clamp(32px,5vw,56px); font-weight:700; text-transform:none; line-height:1.1; letter-spacing:-.03em; margin:0 0 10px; }
    .intro { margin:0; max-width:850px; font-size:15px; }
    .preview-note { margin:5px 0 0; color:var(--muted); font-size:13px; }
    .contract-flow { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; margin:0 0 22px; padding:16px 0; list-style:none; border-block:1px solid var(--border); }
    .contract-flow li { display:flex; align-items:start; gap:10px; min-width:0; }
    .contract-flow li>span { color:var(--muted); font:13px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace; }
    .contract-flow strong { display:block; font-size:13px; font-weight:600; }
    .contract-flow code { display:block; margin-top:3px; color:var(--muted); font:12.5px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace; }
    .workbench { display:grid; grid-template-columns:minmax(0,1.12fr) minmax(0,1fr); gap:24px; align-items:start; }
    .code-panel,.controls-panel { min-width:0; border:1px solid var(--border); background:var(--surface); border-radius:6px; }
    .panel-heading { min-height:45px; padding:12px 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; gap:12px; font-size:13px; }
    .panel-heading span { min-width:0; overflow-wrap:anywhere; }
    .panel-heading a { flex:none; font-size:13px; }
    :global(.primary-code pre), :global(.full-source pre) { margin:0; padding:16px; max-width:100%; overflow:auto; background:var(--code)!important; color:var(--token)!important; font:12.5px/1.6 var(--mp-font-mono); tab-size:4; }
    :global(.primary-code code), :global(.full-source code) { font:inherit; }
    :global(.primary-code .token.comment), :global(.full-source .token.comment) { color:var(--comment)!important; }
    .source-note { margin:0; padding:0 16px 13px; color:var(--muted); font-size:12.5px; }
    .full-source { border-top:1px solid var(--border); padding:12px 16px; font-size:13px; }
    summary { cursor:pointer; color:var(--muted); }
    .controls-panel>form { padding:14px 16px 0; }
    label { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:5px 8px; margin:0 0 14px; font-weight:600; font-size:13px; }
    label span, label small { color:var(--muted); font-weight:400; font-size:12.5px; } label span { text-align:right; }
    label small { grid-column:1/-1; }
    input,select,button { font:inherit; min-height:44px; border:1px solid var(--control-border); border-radius:6px; }
    .actions button, .boundary-test { font-family:var(--mp-font-sans); }
    input,select { grid-column:1/-1; width:100%; padding:9px 10px; color:var(--ink); background:var(--surface); }
    :is(input,select,button,a,summary):focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
    .actions { display:flex; gap:8px; align-items:center; }
    .actions button { margin:0; height:44px; padding:0 16px; font-size:13px; font-weight:600; cursor:pointer; color:var(--button-text); background:var(--button); border-color:var(--button); }
    .actions button.secondary { color:var(--ink); background:var(--surface); border-color:var(--border); }
    .boundary-test { min-height:44px; margin:4px 0 0; padding:0; font-size:12.5px; border:0; background:none; color:var(--accent); cursor:pointer; text-decoration:underline; text-underline-offset:3px; }
    #rejection { color:var(--red); font-size:13px; font-weight:500; margin:4px 0 14px; } #rejection:empty { display:none; }
    .result { padding:14px 16px 16px; border-top:1px solid var(--border); }
    .result-label { margin:0 0 9px; color:var(--muted); font-size:13px; }
    .result-top { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:8px; }
    .result h2 { margin:0; font-size:19px; font-weight:600; }
    #status { color:var(--muted); font-size:11.5px; }
    #result-copy { margin:6px 0 13px; color:var(--muted); font-size:13px; }
    dl { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px 16px; margin:0; } dl div { min-width:0; padding-top:7px; border-top:1px solid var(--border); } dt { color:var(--muted); font-size:12.5px; } dd { margin:3px 0 0; font-size:13px; font-weight:600; overflow-wrap:anywhere; }
    .execution-detail { margin-top:12px; font-size:12.5px; } .execution-detail p { color:var(--muted); overflow-wrap:anywhere; margin:6px 0; }
    .steps { padding-left:18px; color:var(--muted); } .steps li.active { color:var(--ink); }
    .boundary { max-width:1000px; margin:18px 0 0; color:var(--muted); font-size:12.5px; }
    @media(max-width:850px) { main { padding:20px; } .workbench { gap:16px; grid-template-columns:minmax(0,1fr); } .contract-flow { gap:12px; } }
    :is(input,select,button,a,summary):focus-visible { outline:2px solid var(--focus); outline-offset:2px; }
    @media(max-width:799px) {
      .family-header { gap:0; padding-inline:16px; }
      .family-header .product-home { margin-right:0; font-size:14px; }
      .family-header .family-home-mobile { display:inline-flex; justify-content:center; min-width:44px; margin-left:4px; padding-inline:2px; font-size:12px; }
      .family-header .family-menu-button { display:inline-flex; align-items:center; justify-content:center; min-width:48px; min-height:44px; margin-left:4px; padding:0 4px; border:1px solid var(--control-border); border-radius:6px; background:var(--raised); color:var(--ink); font:600 12px/1.4 var(--mp-font-sans); cursor:pointer; }
      .family-links { display:none; }
      .family-mobile-menu:not([hidden]) { position:fixed; z-index:100; inset:64px 0 auto; display:block; max-height:calc(100dvh - 64px); overflow:auto; padding:12px 16px 24px; border-block:1px solid var(--border); background:var(--raised); box-shadow:0 8px 16px rgb(0 0 0 / .16); }
    }
    @media(max-width:768px) { main { padding-inline:16px; } .workbench { grid-template-columns:minmax(0,1fr); } }
    @media(max-width:500px) { .family-header { gap:0; padding-inline:16px; font-size:13px; } .family-header .product-home { font-size:14px; } main { padding:16px 16px 24px; } nav { font-size:14px; gap:10px; } header { margin-top:24px; } .contract-flow { grid-template-columns:1fr; gap:12px; padding-block:14px; } .contract-flow li>span { width:22px; flex:none; } .contract-flow li div { display:flex; flex-wrap:wrap; align-items:baseline; gap:4px 10px; } .contract-flow code { margin:0; } label { grid-template-columns:1fr; } label span { text-align:left; } .panel-heading { padding-inline:12px; flex-wrap:wrap; } .controls-panel>form { padding-inline:12px; } .result { padding-inline:12px; } }
    @media(prefers-reduced-motion:reduce) { :global(*) { scroll-behavior:auto!important; animation:none!important; } }
  </style>
</body>
</html>
